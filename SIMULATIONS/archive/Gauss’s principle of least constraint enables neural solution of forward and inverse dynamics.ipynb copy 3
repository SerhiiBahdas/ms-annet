    "fig.colorbar(im0, ax=axes[0], pad=0.01, label='Mean absolute angular error (rad)')\n",
    "\n",
    "im1 = axes[1].imshow(time_grid.cpu(), aspect='auto', origin='lower', cmap='cividis')\n",
    "axes[1].set_title('Full update time for each best pair', loc='left', fontweight='bold')\n",
    "axes[1].set_xlabel('Sampled acceleration vectors')\n",
    "axes[1].set_ylabel('Uniform bound (+/- rad/s^2)')\n",
    "axes[1].set_xticks(range(len(GRID_SAMPLED_ACCELERATION_VECTORS)), labels=GRID_SAMPLED_ACCELERATION_VECTORS, rotation=45)\n",
    "axes[1].set_yticks(range(len(GRID_UNIFORM_BOUNDS)), labels=[format_bound(v) for v in GRID_UNIFORM_BOUNDS])\n",
    "fig.colorbar(im1, ax=axes[1], pad=0.01, label='Mean full update time (ms)')\n",
