    ")\n",
    "adam_grid = torch.empty_like(error_grid)\n",
    "time_grid = torch.empty_like(error_grid)\n",
    "\n",
    "for row_idx, bound in enumerate(GRID_UNIFORM_BOUNDS):\n",
    "    for col_idx, candidate_count in enumerate(GRID_SAMPLED_ACCELERATION_VECTORS):\n",
    "        row = best_pair_df[\n",
    "            (best_pair_df['candidate_count'] == candidate_count)\n",
    "            & (best_pair_df['bound'] == bound)\n",
    "        ].iloc[0]\n",
    "        error_grid[row_idx, col_idx] = float(row['mean_abs_angle_error_rad'])\n",
    "        adam_grid[row_idx, col_idx] = float(row['adam_steps'])\n",
    "        time_grid[row_idx, col_idx] = float(row['mean_update_ms'])\n",
