    "\n",
    "print(\"-\" * 70 + \"\\n\")\n",
    "\n",
    "\n",
    "# Generate and save box plot for RMSE distribution\n",
    "\n",
    "# Following this, we create a Nature-style box plot for RMSE across dataset sizes\n",
    "\n",
    "# Define file path for saving figure\n",
    "fig_name = \"nature_rmse_distribution_boxplot.svg\"\n",
    "save_fig_path = os.path.join(results_path, fig_name)\n",
    "\n",
    "# Set figure dimensions for double-column width (Nature style)\n",
    "fig_width  = double_col\n",
    "fig_height = double_col * golden_ratio * 0.8  # Slightly shorter for compactness\n",
    "plt.figure(figsize=(fig_width, fig_height))\n",
    "\n",
    "# Calculate median RMSE values by dataset size and joint for trendline fitting\n",
    "median_rmse = (\n",
    "    df_rmse\n",
    "    .groupby(['Joint', 'Dataset_Size'], as_index=False)['RMSE']\n",
    "    .median()\n",
    "    .rename(columns={'RMSE': 'Median_RMSE'})\n",
    ")\n",
    "\n",
    "# Keep the box and trendline colors paired by joint\n",
    "joint_colors = ['#4DBBD5', '#E64B35']  # Nature-style blue/red\n",
    "joint_palette = {joint: joint_colors[i % len(joint_colors)] for i, joint in enumerate(joints)}\n",
    "box_width = 0.6\n",
    "\n",
    "# Create box plot with joint-specific colors and no outliers\n",
    "ax = sns.boxplot(\n",
    "    data=df_rmse,\n",
    "    x='Dataset_Size',\n",
    "    y='RMSE',\n",
    "    hue='Joint',\n",
    "    order=sizes,\n",
    "    hue_order=joints,\n",
    "    palette=joint_palette,\n",
    "    showfliers=False,                 # Hide outliers for cleaner view\n",
    "    width=box_width,\n",
    "    linewidth=0.8\n",
    ")\n",
    "\n",
    "# Fit and overlay dashed power-law learning curves at categorical tick positions\n",
    "tick_positions = ax.get_xticks()\n",
    "size_to_x = dict(zip(sizes, tick_positions))\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.patches as mpatches\n",
    "from scipy.optimize import curve_fit\n",
    "from matplotlib.legend_handler import HandlerTuple\n",
    "\n",
    "def power_law_decay(x, a, b, c):\n",
    "    return a * np.power(x, -b) + c\n",
    "\n",
    "def calculate_r_squared(y_observed, y_predicted):\n",
    "    residual_sum_squares = np.sum((y_observed - y_predicted) ** 2)\n",
    "    total_sum_squares = np.sum((y_observed - np.mean(y_observed)) ** 2)\n",
    "    if total_sum_squares == 0:\n",
    "        return np.nan\n",
    "    return 1 - (residual_sum_squares / total_sum_squares)\n",
    "\n",
    "def get_pairwise_results_for_joint(joint_name, df, sizes, correction='fdr_bh', alpha=0.05):\n",
    "    if 'rmse_pairwise_results' in globals() and joint_name in rmse_pairwise_results:\n",
    "        return rmse_pairwise_results[joint_name]\n",
    "\n",
    "    raw_p_values = []\n",
    "    indices = []\n",
    "    for i in range(len(sizes)):\n",
    "        for j in range(i + 1, len(sizes)):\n",
    "            size_a = sizes[i]\n",
    "            size_b = sizes[j]\n",
    "            data_a = df[(df['Dataset_Size'] == size_a) & (df['Joint'] == joint_name)]['RMSE']\n",
    "            data_b = df[(df['Dataset_Size'] == size_b) & (df['Joint'] == joint_name)]['RMSE']\n",
    "            _, p = scipy_stats.mannwhitneyu(data_a, data_b, alternative='two-sided')\n",
    "            raw_p_values.append(p)\n",
    "            indices.append((i, j))\n",
    "\n",
    "    reject, corrected_p_values, _, _ = multipletests(raw_p_values, alpha=alpha, method=correction)\n",
    "    pairs = {}\n",
    "    for k, (i, j) in enumerate(indices):\n",
    "        pairs[(sizes[i], sizes[j])] = {\n",
    "            'p_adj': float(corrected_p_values[k]),\n",
    "            'reject': bool(reject[k]),\n",
    "            'correction': correction,\n",
    "            'alpha': alpha,\n",
    "        }\n",
    "    return {'joint': joint_name, 'sizes': list(sizes), 'pairs': pairs, 'correction': correction, 'alpha': alpha}\n",
    "\n",
    "def get_pairwise_result(pairwise_results, size_a, size_b):\n",
    "    pairs = pairwise_results.get('pairs', {})\n",
    "    return pairs.get((size_a, size_b), pairs.get((size_b, size_a)))\n",
    "\n",
    "def compact_letter_display(sizes, pairwise_results, alpha=0.05):\n",
    "    n = len(sizes)\n",
    "    significant = np.zeros((n, n), dtype=bool)\n",
    "\n",
    "    for i in range(n):\n",
    "        for j in range(i + 1, n):\n",
    "            result = get_pairwise_result(pairwise_results, sizes[i], sizes[j])\n",
    "            if result is None:\n",
    "                is_significant = False\n",
    "            else:\n",
    "                is_significant = bool(result.get('reject', result.get('p_adj', 1.0) < alpha))\n",
    "            significant[i, j] = significant[j, i] = is_significant\n",
    "\n",
    "    all_cliques = []\n",
    "    for mask in range(1, 1 << n):\n",
    "        members = tuple(i for i in range(n) if mask & (1 << i))\n",
    "        if all(not significant[i, j] for idx, i in enumerate(members) for j in members[idx + 1:]):\n",
    "            all_cliques.append(members)\n",
    "\n",
    "    maximal_cliques = []\n",
    "    for clique in all_cliques:\n",
    "        clique_set = set(clique)\n",
    "        if not any(clique_set < set(other) for other in all_cliques):\n",
    "            maximal_cliques.append(clique)\n",
    "\n",
    "    universe = {('v', i) for i in range(n)}\n",
    "    universe.update(('e', i, j) for i in range(n) for j in range(i + 1, n) if not significant[i, j])\n",
    "\n",
    "    def clique_coverage(clique):\n",
    "        coverage = {('v', i) for i in clique}\n",
    "        coverage.update(('e', i, j) for idx, i in enumerate(clique) for j in clique[idx + 1:])\n",
    "        return coverage\n",
    "\n",
    "    selected_cliques = []\n",
    "    uncovered = set(universe)\n",
    "    candidates = list(maximal_cliques)\n",
    "    while uncovered and candidates:\n",
    "        best = max(\n",
    "            candidates,\n",
    "            key=lambda clique: (len(clique_coverage(clique) & uncovered), len(clique), -min(clique))\n",
    "        )\n",
    "        covered = clique_coverage(best) & uncovered\n",
    "        if not covered:\n",
    "            break\n",
    "        selected_cliques.append(best)\n",
    "        uncovered -= covered\n",
    "        candidates.remove(best)\n",
    "\n",
    "    selected_cliques.sort(key=lambda clique: (min(clique), -len(clique), clique))\n",
    "\n",
    "    def letter_for_index(index):\n",
    "        alphabet = 'abcdefghijklmnopqrstuvwxyz'\n",
    "        if index < len(alphabet):\n",
    "            return alphabet[index]\n",
    "        return alphabet[(index // len(alphabet)) - 1] + alphabet[index % len(alphabet)]\n",
    "\n",
    "    labels = {size: '' for size in sizes}\n",
    "    for letter_index, clique in enumerate(selected_cliques):\n",
    "        letter = letter_for_index(letter_index)\n",
    "        for member in clique:\n",
    "            labels[sizes[member]] += letter\n",
    "\n",
    "    return labels\n",
    "\n",
    "print(f\"\\n{'='*20} Power-Law Fits to Median RMSE {'='*20}\")\n",
    "print(\"Model: RMSE = a * Dataset_Size^(-b) + c\")\n",
    "print(f\"{'Joint':<6} | {'a':>12} | {'b':>12} | {'c':>12} | {'R^2':>8}\")\n",
    "print(\"-\" * 63)\n",
    "fit_results = {}\n",
    "legend_labels = {}\n",
    "\n",
    "for joint in joints:\n",
    "    joint_medians = median_rmse[median_rmse['Joint'] == joint].copy()\n",
    "    joint_medians['x_pos'] = joint_medians['Dataset_Size'].map(size_to_x)\n",
    "    joint_medians = joint_medians.dropna(subset=['x_pos', 'Median_RMSE']).sort_values('x_pos')\n",
    "\n",
    "    if len(joint_medians) < 3:\n",
    "        print(f\"{joint:<6} | {'Insufficient data for 3-parameter fit':>51}\")\n",
    "        continue\n",
    "\n",
    "    x_data = joint_medians['Dataset_Size'].astype(float).to_numpy()\n",
    "    y_data = joint_medians['Median_RMSE'].astype(float).to_numpy()\n",
    "    x_pos = joint_medians['x_pos'].astype(float).to_numpy()\n",
    "\n",
    "    c0 = max(np.min(y_data) * 0.8, 0)\n",
    "    a0 = max((np.max(y_data) - c0) * np.sqrt(np.min(x_data)), 1e-12)\n",
    "    p0 = [a0, 0.5, c0]\n",
    "\n",
    "    coeffs, _ = curve_fit(\n",
    "        power_law_decay,\n",
    "        x_data,\n",
    "        y_data,\n",
    "        p0=p0,\n",
    "        bounds=([0, 0, 0], [np.inf, np.inf, np.inf]),\n",
    "        maxfev=10000\n",
    "    )\n",
    "\n",
    "    y_pred = power_law_decay(x_data, *coeffs)\n",
    "    r_squared = calculate_r_squared(y_data, y_pred)\n",
    "    a, b, c = coeffs\n",
    "    fit_results[joint] = {'a': a, 'b': b, 'c': c, 'r_squared': r_squared}\n",
    "    legend_labels[joint] = f\"{joint} (Power-law: y = {a:.2g}N^(-{b:.2g}) + {c:.2g}; R^2 = {r_squared:.3f})\"\n",
    "    print(f\"{joint:<6} | {a:>12.6g} | {b:>12.6g} | {c:>12.6g} | {r_squared:>8.4f}\")\n",
    "\n",
    "    x_plot = np.linspace(x_pos.min(), x_pos.max(), 200)\n",
    "    dataset_size_plot = np.interp(x_plot, x_pos, x_data)\n",
    "    y_fit = power_law_decay(dataset_size_plot, *coeffs)\n",
    "\n",
    "    ax.plot(\n",
    "        x_plot,\n",
    "        y_fit,\n",
    "        color=joint_palette[joint],\n",
    "        linestyle='--',\n",
    "        linewidth=1.4,\n",
    "        label='_nolegend_',\n",
    "        zorder=5\n",
    "    )\n",
    "\n",
    "print(\"-\" * 63 + \"\\n\")\n",
    "\n",
    "# Use a compact letter display to summarize pairwise significance without clutter\n",
    "pairwise_results_by_joint = {\n",
    "    joint: get_pairwise_results_for_joint(joint, df_rmse, sizes)\n",
    "    for joint in joints\n",
    "}\n",
    "cld_by_joint = {\n",
    "    joint: compact_letter_display(\n",
    "        sizes,\n",
    "        pairwise_results_by_joint[joint],\n",
    "        alpha=pairwise_results_by_joint[joint].get('alpha', 0.05)\n",
    "    )\n",
    "    for joint in joints\n",
    "}\n",
    "\n",
    "y_min, y_max = ax.get_ylim()\n",
    "y_range = y_max - y_min if y_max > y_min else max(abs(y_max), 1)\n",
    "letter_offset = y_range * 0.025\n",
    "hue_offsets = {\n",
    "    joint: (idx - (len(joints) - 1) / 2) * (box_width / len(joints))\n",
    "    for idx, joint in enumerate(joints)\n",
    "}\n",
    "annotation_y_max = y_max\n",
    "\n",
    "print(f\"\\n{'='*20} Compact Letter Display (Median RMSE) {'='*20}\")\n",
    "print(\"Within each joint, dataset sizes sharing a letter are not significantly different (FDR-adjusted p >= 0.05).\")\n",
    "for joint in joints:\n",
    "    cld_summary = ', '.join(f\"{size}: {cld_by_joint[joint][size]}\" for size in sizes)\n",
    "    print(f\"{joint}: {cld_summary}\")\n",
    "\n",
    "    for size in sizes:\n",
    "        subset = df_rmse[(df_rmse['Dataset_Size'] == size) & (df_rmse['Joint'] == joint)]['RMSE']\n",
    "        if len(subset) == 0:\n",
    "            continue\n",
    "\n",
    "        q1 = subset.quantile(0.25)\n",
    "        q3 = subset.quantile(0.75)\n",
    "        iqr = q3 - q1\n",
    "        upper_whisker = min(subset.max(), q3 + 1.5 * iqr)\n",
    "        x_text = size_to_x[size] + hue_offsets[joint]\n",
    "        y_text = upper_whisker + letter_offset\n",
    "        annotation_y_max = max(annotation_y_max, y_text)\n",
    "\n",
    "        ax.text(\n",
    "            x_text,\n",
    "            y_text,\n",
    "            cld_by_joint[joint][size],\n",
    "            ha='center',\n",
    "            va='bottom',\n",
    "            color=joint_palette[joint],\n",
    "            fontsize=6,\n",
    "            fontweight='bold',\n",
    "            zorder=6\n",
    "        )\n",
    "\n",
    "print(\"-\" * 76 + \"\\n\")\n",
    "ax.set_ylim(y_min, max(y_max, annotation_y_max + y_range * 0.08))\n",
    "\n",
    "# Set plot title and axis labels\n",
    "plt.title('RMSE Distribution by Training Dataset Size')\n",
    "plt.ylabel('Root Mean Squared Error (RMSE)')\n",
    "plt.xlabel('Training Dataset Size (Samples)')\n",
    "\n",
    "# Configure descriptive legend without frame\n",
    "legend_handles = []\n",
