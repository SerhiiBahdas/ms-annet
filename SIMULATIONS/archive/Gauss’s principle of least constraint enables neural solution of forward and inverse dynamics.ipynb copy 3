    "\n",
    "candidate_buffer = torch.empty(COARSE_SAMPLES, 2, dtype=TORCH_DTYPE, device=device)\n",
    "zero_ddq = torch.zeros(2, dtype=TORCH_DTYPE, device=device)\n",
    "zero_scalar = torch.tensor(0.0, dtype=TORCH_DTYPE, device=device)\n",
