   "cell_type": "markdown",
   "metadata": {
    "id": "XWf67BgwzJM0"
   },
   "source": [
    "Second, we rewrite the double-pendulum equations in first-order form so they can be integrated numerically, returning time derivatives of angles and velocities at each step."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 114,
   "metadata": {
    "executionInfo": {
     "elapsed": 1,
     "status": "ok",
     "timestamp": 1775090563692,
     "user": {
      "displayName": "Serhii Bahdasariants",
      "userId": "11867698180838522564"
     },
     "user_tz": 240
    },
    "id": "eFRk0no25DxS"
   },
   "outputs": [],
   "source": [
    "# Numerical ODE solvers require the dynamics to be written\n",
    "# as a first-order system of the form d/dt [q, dq] = f(q, dq).\n",
    "\n",
    "@torch.compile(dynamic=False, fullgraph=True, mode=TORCH_COMPILE_MODE)\n",
    "def derive_double_pendulum_ode(t, state, m1_t, m2_t, l1_t, l2_t, g_t):\n",
    "    del t\n",
    "    q1_v, q2_v, dq1_v, dq2_v = state.unbind()\n",
    "    accel_1, accel_2 = _compute_accelerations_torch(\n",
    "        q1_v, q2_v, dq1_v, dq2_v, m1_t, m2_t, l1_t, l2_t, g_t\n",
    "    )\n",
    "    return torch.stack((dq1_v, dq2_v, accel_1, accel_2))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "DXmKyOxOzbhH"
   },
   "source": [
    "Third, I define a function that generates double-pendulum trajectories by integrating the system's ODEs, recording angles, velocities, and accelerations at each timestep to serve as ground-truth data for later analyses."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 115,
   "metadata": {
    "executionInfo": {
     "elapsed": 1,
     "status": "ok",
     "timestamp": 1775090563693,
     "user": {
      "displayName": "Serhii Bahdasariants",
      "userId": "11867698180838522564"
     },
     "user_tz": 240
    },
    "id": "Q4eeRuK15EmT"
   },
   "outputs": [],
   "source": [
    "# Generate a single double-pendulum trajectory using fixed-step RK4.\n",
    "def generate_trajectory(duration=5.0, dt=0.001):\n",
    "    t_axis = torch.arange(0.0, duration + dt, dt, dtype=TORCH_DTYPE, device=device)\n",
    "\n",
    "    q_init = torch.empty(2, dtype=TORCH_DTYPE, device=device).uniform_(-torch.pi / 3, torch.pi / 3)\n",
    "    dq_init = torch.zeros(2, dtype=TORCH_DTYPE, device=device)\n",
    "    state = torch.cat((q_init, dq_init))\n",
    "\n",
    "    m1_t = as_f32_tensor(PARAMS['m1'], device=device)\n",
    "    m2_t = as_f32_tensor(PARAMS['m2'], device=device)\n",
    "    l1_t = as_f32_tensor(PARAMS['l1'], device=device)\n",
    "    l2_t = as_f32_tensor(PARAMS['l2'], device=device)\n",
    "    g_t = as_f32_tensor(9.81, device=device)\n",
    "\n",
    "    traj = []\n",
    "    for t in t_axis:\n",
    "        d_state = derive_double_pendulum_ode(t, state, m1_t, m2_t, l1_t, l2_t, g_t)\n",
    "        ddq = d_state[2:]\n",
    "        traj.append(torch.cat((state, ddq)))\n",
    "\n",
    "        k1 = d_state\n",
    "        k2 = derive_double_pendulum_ode(t + 0.5 * dt, state + 0.5 * dt * k1, m1_t, m2_t, l1_t, l2_t, g_t)\n",
    "        k3 = derive_double_pendulum_ode(t + 0.5 * dt, state + 0.5 * dt * k2, m1_t, m2_t, l1_t, l2_t, g_t)\n",
    "        k4 = derive_double_pendulum_ode(t + dt, state + dt * k3, m1_t, m2_t, l1_t, l2_t, g_t)\n",
    "\n",
    "        state = state + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)\n",
    "\n",
    "    return torch.stack(traj), t_axis\n"
   ]
  },
