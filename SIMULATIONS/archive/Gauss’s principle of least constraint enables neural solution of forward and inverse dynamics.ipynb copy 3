    "ID_TRAJ = 1\n",
    "\n",
    "# Dataset sizes (number of samples)\n",
    "MODEL_NUMS = dataset_sizes\n",
    "\n",
    "# Base directory for inverse dynamics results\n",
    "BASE_PATH = output_dir\n",
    "\n",
    "# Fixed integration time step (seconds)\n",
