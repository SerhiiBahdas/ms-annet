   },
   "outputs": [],
   "source": [
    "# Random seed for reproducible results\n",
    "SEED = 23\n",
    "torch.manual_seed(SEED)\n",
    "\n",
    "# Number of simulated trajectories\n",
    "NUM_TRAJECTORIES = 50\n",
    "\n",
    "# Path for saving the generated dataset\n",
    "SAVE_PATH = \"double_pendulum_dataset.pt\"\n",
    "\n",
